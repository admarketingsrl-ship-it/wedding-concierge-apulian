rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all for unmatched documents
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidWedding(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.weddingCode is string && data.weddingCode.size() <= 100 &&
             data.coupleNames is string && data.coupleNames.size() <= 200;
    }

    function isValidChatMessage(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.weddingCode is string && data.weddingCode.size() <= 100 &&
             data.text is string && data.text.size() <= 5000 &&
             data.sender is string && data.sender.size() <= 50;
    }

    // Connection verification document
    match /test/{docId} {
      allow read: if true;
    }

    // Users collection: only owner can read/write
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Weddings collection: accessible by guests and couples via wedding code, and by concierge admin
    match /weddings/{weddingId} {
      allow get, list: if true;
      allow create: if isValidId(weddingId) && isValidWedding(request.resource.data);
      allow update: if isValidId(weddingId) && isValidWedding(request.resource.data);
      allow delete: if isValidId(weddingId);
    }

    // Concierge chat messages collection: shared in real time between guest/couple and concierge
    match /chat_messages/{messageId} {
      allow get, list: if true;
      allow create: if isValidId(messageId) && isValidChatMessage(request.resource.data);
      allow update: if isValidId(messageId) && isValidChatMessage(request.resource.data);
      allow delete: if isValidId(messageId);
    }
  }
}
