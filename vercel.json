{
  "rewrites": [
    { "source": "/api/send-email", "destination": "/api/send-email.js" },
    { "source": "/api/onboarding", "destination": "/api/index.js" },
    { "source": "/api/onboarding/(.*)", "destination": "/api/index.js" },
    { "source": "/api/weddings/code/(.*)", "destination": "/api/weddings/code/index.js" },
    { "source": "/api/weddings", "destination": "/api/weddings.js" },
    { "source": "/api/weddings/(.*)", "destination": "/api/weddings.js" },
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
